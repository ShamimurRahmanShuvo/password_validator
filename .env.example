#############################################
# PASSWORD LENGTH
#############################################

PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=64

#############################################
# REQUIRED CHARACTER TYPES
#############################################

PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true

#############################################
# MINIMUM COUNTS
#############################################

PASSWORD_MIN_UPPERCASE=1
PASSWORD_MIN_LOWERCASE=1
PASSWORD_MIN_DIGITS=1
PASSWORD_MIN_SPECIAL=1

#############################################
# SPECIAL CHARACTERS
#############################################

PASSWORD_ALLOWED_SPECIAL=!@#$%^&*()_+-=[]{}|;:,.<>?

#############################################
# WHITESPACE
#############################################

PASSWORD_ALLOW_SPACES=false

#############################################
# REPEATED CHARACTERS
#############################################

PASSWORD_MAX_REPEAT=2

#############################################
# SEQUENTIAL CHARACTERS
#############################################

PASSWORD_CHECK_SEQUENTIAL=true

#############################################
# BLACKLIST
#############################################

PASSWORD_CHECK_COMMON=true

#############################################
# DICTIONARY
#############################################

PASSWORD_CHECK_DICTIONARY=true

#############################################
# CUSTOM REGEX
#############################################

PASSWORD_CUSTOM_REGEX=

#############################################
# ENTROPY
#############################################

PASSWORD_MIN_ENTROPY=40

#############################################
# ERROR LANGUAGE
#############################################

PASSWORD_LANGUAGE=en

###########################################################
# PASSWORD STRENGTH SCORING
###########################################################

STRENGTH_LENGTH_8_SCORE=10
STRENGTH_LENGTH_12_SCORE=10
STRENGTH_LENGTH_16_SCORE=10
STRENGTH_LENGTH_20_SCORE=10

STRENGTH_LOWERCASE_SCORE=5
STRENGTH_UPPERCASE_SCORE=5
STRENGTH_DIGIT_SCORE=5
STRENGTH_SPECIAL_SCORE=10

STRENGTH_UNIQUE_CHARACTER_SCORE=15

STRENGTH_ENTROPY_40_SCORE=5
STRENGTH_ENTROPY_60_SCORE=10
STRENGTH_ENTROPY_80_SCORE=15

###########################################################
# PENALTIES
###########################################################

PENALTY_REPEATED_CHARACTER=15
PENALTY_SEQUENTIAL_CHARACTER=15
PENALTY_KEYBOARD_PATTERN=20
PENALTY_COMMON_PASSWORD=40
PENALTY_DICTIONARY_WORD=20

###########################################################
# BONUS
###########################################################

BONUS_LONG_PASSWORD=10
BONUS_MIXED_CHARACTER_SET=10

###########################################################
# MAXIMUM SCORE
###########################################################

MAX_PASSWORD_SCORE=100

###########################################################
# REPEATED CHARACTER ANALYSIS
###########################################################

# Maximum allowed consecutive occurrences of the same character
STRENGTH_MAX_CONSECUTIVE_REPEAT=2

# Minimum group length to consider as a repeated sequence
STRENGTH_MIN_REPEATED_GROUP_LENGTH=2

# Minimum number of times a group must repeat
STRENGTH_MIN_GROUP_REPETITIONS=2

# Maximum percentage of password occupied by one character
# Example: 0.30 means 30%
STRENGTH_MAX_CHARACTER_FREQUENCY=0.30

# Enable repeated character analysis
STRENGTH_CHECK_REPEATED_CHARACTERS=true

# Enable repeated group analysis
STRENGTH_CHECK_REPEATED_GROUPS=true

# Enable character frequency analysis
STRENGTH_CHECK_CHARACTER_FREQUENCY=true

###########################################################
# SEQUENTIAL PATTERN ANALYSIS
###########################################################

STRENGTH_CHECK_SEQUENTIAL=true

STRENGTH_MIN_SEQUENCE_LENGTH=4

STRENGTH_CHECK_DIGIT_SEQUENCES=true

STRENGTH_CHECK_LOWERCASE_SEQUENCES=true

STRENGTH_CHECK_UPPERCASE_SEQUENCES=true

STRENGTH_CHECK_MIXED_SEQUENCES=false

###########################################################
# KEYBOARD PATTERN ANALYSIS
###########################################################

STRENGTH_CHECK_KEYBOARD_PATTERNS=true

STRENGTH_MIN_KEYBOARD_PATTERN_LENGTH=4

STRENGTH_CHECK_HORIZONTAL_KEYBOARD=true

STRENGTH_CHECK_VERTICAL_KEYBOARD=true

STRENGTH_CHECK_DIAGONAL_KEYBOARD=true

STRENGTH_CHECK_NUMBER_ROW_KEYBOARD=true

STRENGTH_KEYBOARD_CASE_INSENSITIVE=true

###########################################################
# DICTIONARY / COMMON PASSWORD ANALYSIS
###########################################################

STRENGTH_CHECK_DICTIONARY=true

STRENGTH_CHECK_COMMON_PASSWORDS=true

STRENGTH_DICTIONARY_FILE=

STRENGTH_COMMON_PASSWORD_FILE=

STRENGTH_MIN_DICTIONARY_WORD_LENGTH=4

STRENGTH_DICTIONARY_CASE_INSENSITIVE=true

STRENGTH_DICTIONARY_LEET_NORMALIZATION=true